import { useEffect, useMemo, useRef } from 'react'
import { useFrame, type ThreeEvent } from '@react-three/fiber'
import { AdditiveBlending, BufferAttribute, BufferGeometry, Color, MathUtils, Vector3 } from 'three'

import { PALETTE, PARTICLES, RENDER } from '../../config'
import { getRose } from '../../math/geometry'
import type { Tier } from '../../math/rose'
import { createRoseMaterials } from '../../shaders/growth'
import { frontGlow, roseGrow, type MathMode, type Phase, type Schedule } from '../../state'

export interface RoseHit {
  point: Vector3
  time: number
}

export interface MathematicalRoseProps {
  tier: Tier
  phase: Phase
  schedule: Schedule
  /** ROSA o MATEMÁTICA. La disolución se interpola a partir de aquí. */
  mode: MathMode
  reduced: boolean
  /** Se dispara con un toque limpio, no con un arrastre. */
  onTap: () => void
}

/**
 * La superficie de la rosa.
 *
 * Solo la superficie: la estructura matematica (wireframe y puntos) vive en
 * MathModel, que comparte la MISMA BufferGeometry. Repartirlas asi evita
 * dibujar el wireframe dos veces cuando el usuario cambia de modo.
 *
 * uProgress queda clavado al valor del crecimiento: al cambiar de modo la
 * rosa no vuelve a construirse.
 */
export function MathematicalRose({
  tier,
  phase,
  schedule,
  mode,
  reduced,
  onTap,
}: MathematicalRoseProps) {
  const rose = useMemo(() => getRose(tier), [tier])
  const core = useMemo(() => new Vector3(...rose.core), [rose])

  const mats = useMemo(
    () =>
      createRoseMaterials({
        color: PALETTE.petal,
        core: PALETTE.core,
        rim: PALETTE.rim,
        glow: PALETTE.glow,
        roughness: 0.78,
        // Acabado carmesí aterciopelado: CERO laca plástica (clearcoat = 0),
        // alta micro-rugosidad difusa y BRDF sheen de terciopelo completo.
        clearcoat: 0.0,
        clearcoatRoughness: 1.0,
        sheen: 1.0,
        sheenRoughness: 0.48,
        emissiveIntensity: 0.06,
        base: core,
        band: RENDER.growthBand,
        transparent: true,
      }),
    [core],
  )

  useEffect(() => {
    mats.uniforms.uHitGain.value = 0.5
    return () => mats.dispose()
  }, [mats])

  // ── Toque limpio ≠ arrastre ────────────────────────────────────────────────
  // Un pulso luminoso que se dispara al empezar a girar la rosa resultaría
  // ruidoso, así que se compara el recorrido del puntero antes de dispararlo.
  const down = useRef<{ x: number; y: number } | null>(null)
  const handleDown = (e: ThreeEvent<PointerEvent>) => {
    down.current = { x: e.nativeEvent.clientX, y: e.nativeEvent.clientY }
  }
  const handleClick = (e: ThreeEvent<MouseEvent>) => {
    const start = down.current
    down.current = null
    if (!start) return
    const dx = e.nativeEvent.clientX - start.x
    const dy = e.nativeEvent.clientY - start.y
    if (dx * dx + dy * dy > 36) return
    if (phase !== 'INTERACTIVE') return
    // Se guarda el punto; la uniform se escribe en el siguiente frame desde
    // useFrame, que es donde se tiene el reloj de la escena. Si aquí se
    // calculara con performance.now() el anillo nunca coincidiría con uTime.
    pendingHit.current = e.point.clone()
    onTap()
  }

  const pendingHit = useRef<Vector3 | null>(null)
  const dissolveRef = useRef(0)

  useFrame((state, dt) => {
    const u = mats.uniforms

    if (pendingHit.current) {
      u.uHitPoint.value.copy(pendingHit.current)
      u.uHitTime.value = state.clock.elapsedTime
      pendingHit.current = null
    }

    // Crecimiento y brillo del frente se leen de la línea de tiempo, no de
    // props: van a 60 fps y pasarlos por setState remontaría la escena
    // cientos de veces durante el florecimiento. Un único rAF los escribe.
    const grow = roseGrow(schedule)
    u.uProgress.value = grow * (1 + u.uWidth.value)
    u.uGlowStrength.value = frontGlow(
      schedule,
      RENDER.growthGlowPeak * (reduced ? 0.35 : 1),
    )
    // Los tiempos del shader y el de la línea de tiempo son el mismo reloj.
    u.uTime.value = state.clock.elapsedTime

    // La disolución no es un valor que llegue por prop: se amortigua aquí
    // dentro hacia el modo pedido. Así la transición es continua y no se
    // reinicia el estado de React cada vez que el usuario pulsa.
    const targetDissolve = mode === 'matematica' ? 2 : 0
    // Se acota el dt para que una pestaña en segundo plano no haga que la
    // disolución salte de golpe al volver.
    dissolveRef.current = MathUtils.damp(dissolveRef.current, targetDissolve, 3.2, Math.min(dt, 0.1))
    const d = Math.min(2, Math.max(0, dissolveRef.current))
    // La superficie es lo unico que controla aqui; toda la estructura
    // (wireframe y puntos) pertenece a MathModel, que tiene su propio
    // reveal. Tenerla tambien aqui dibujaria el wireframe DOS veces.
    mats.surface.opacity = 1 - 0.5 * d
    mats.surface.transparent = true
    mats.surface.depthWrite = 1 - 0.5 * d > 0.55
  })

  return (
    <group>
      <mesh
        geometry={rose.geometry}
        material={mats.surface}
        customDepthMaterial={mats.depth}
        castShadow
        receiveShadow
        onPointerDown={handleDown}
        onClick={handleClick}
      />
    </group>
  )
}

/**
 * Un puñado de motas. Lentas, diminutas y casi transparentes: están para que
 * el aire no parezca un vacío, no para que se vean. Ni corazones, ni glitter,
 * ni galaxia.
 *
 * Deterministas: LCG sembrado en lugar de Math.random(), para que la escena
 * sea idéntica en cada carga.
 */
export function RoseParticles({ enabled }: { enabled: boolean }) {
  const count = enabled ? PARTICLES.count : 0

  const { geometry, seeds, drift } = useMemo(() => {
    let seed = 0x2f6e2b1
    const rand = () => {
      seed = (seed * 1664525 + 1013904223) >>> 0
      return seed / 0xffffffff
    }
    const pos = new Float32Array(count * 3)
    const sd = new Float32Array(count * 3)
    const dr = new Float32Array(count)
    for (let i = 0; i < count; i++) {
      const r = 1.1 + rand() * (PARTICLES.spread - 1.1)
      const th = rand() * Math.PI * 2
      const ph = Math.acos(2 * rand() - 1)
      pos[i * 3] = r * Math.sin(ph) * Math.cos(th)
      pos[i * 3 + 1] = r * Math.cos(ph) * 0.55 + 0.1
      pos[i * 3 + 2] = r * Math.sin(ph) * Math.sin(th)
      sd[i * 3] = rand() * Math.PI * 2
      sd[i * 3 + 1] = rand() * Math.PI * 2
      sd[i * 3 + 2] = PARTICLES.sizeMin + rand() * (PARTICLES.sizeMax - PARTICLES.sizeMin)
      dr[i] = PARTICLES.driftMin + rand() * (PARTICLES.driftMax - PARTICLES.driftMin)
    }
    const g = new BufferGeometry()
    g.setAttribute('position', new BufferAttribute(pos, 3))
    return { geometry: g, seeds: sd, drift: dr }
  }, [count])

  const attrRef = useRef<BufferAttribute>(null)

  useEffect(() => () => geometry.dispose(), [geometry])

  useFrame((state, dt) => {
    if (!enabled || count === 0) return
    const attr = geometry.getAttribute('position') as BufferAttribute
    attrRef.current = attr
    const arr = attr.array as Float32Array
    const t = state.clock.elapsedTime
    const lim = PARTICLES.spread
    for (let i = 0; i < count; i++) {
      const i3 = i * 3
      arr[i3] += drift[i] * dt * 0.4
      arr[i3 + 1] += Math.sin(t * 0.21 + seeds[i3]) * drift[i] * dt
      arr[i3 + 2] += Math.cos(t * 0.17 + seeds[i3 + 1]) * drift[i] * dt
      if (arr[i3] > lim) arr[i3] = -lim
      else if (arr[i3] < -lim) arr[i3] = lim
      if (arr[i3 + 2] > lim) arr[i3 + 2] = -lim
      else if (arr[i3 + 2] < -lim) arr[i3 + 2] = lim
    }
    attr.needsUpdate = true
  })

  if (count === 0) return null

  return (
    <points geometry={geometry} frustumCulled={false}>
      <pointsMaterial
        color={PALETTE.highlight}
        size={PARTICLES.sizeMax * 1.8}
        sizeAttenuation
        transparent
        opacity={PARTICLES.opacity}
        depthWrite={false}
        blending={AdditiveBlending}
      />
    </points>
  )
}

/** Color del resplandor, expuesto para el halo de fondo. */
export const GLOW_COLOR = new Color(PALETTE.glow)
</file>

<file path="src/components/Rose/MathModel.tsx">
import { useEffect, useMemo, useRef } from 'react'
import { useFrame } from '@react-three/fiber'
import { MathUtils, Vector3 } from 'three'

import { PALETTE } from '../../config'
import { getRose } from '../../math/geometry'
import type { Tier } from '../../math/rose'
import { createStructureMaterials } from '../../shaders/growth'
import { frontGlow, mathReveal, roseGrow, type MathMode, type Schedule } from '../../state'

export interface MathModelProps {
  tier: Tier
  schedule: Schedule
  mode: MathMode
}

/**
 * La representación matemática: aristas y puntos rojos, sin superficie ni
 * iluminación.
 *
 * Usa el MISMO aProgress y el MISMO crecimiento que la rosa, así que ambas
 * nacen a la vez y en sincronía. Ese es el punto: no hay un objeto que se
 * cambia por otro, hay una flor que pierde las capas que la hacían ser una
 * flor y queda siendo puro cálculo.
 *
 * Los puntos llevan el mismo frente de crecimiento que la superficie, con el
 * mismo resplandor, para que el nacimiento se vea igual en los dos modos.
 */
export function MathModel({ tier, schedule, mode }: MathModelProps) {
  const rose = useMemo(() => getRose(tier), [tier])
  const core = useMemo(() => new Vector3(...rose.core), [rose])

  const struct = useMemo(
    () =>
      createStructureMaterials(
        PALETTE.wire,
        PALETTE.point,
        PALETTE.glow,
        core,
        0.016,
        typeof window !== 'undefined' ? Math.min(window.devicePixelRatio || 1, 2) : 1,
      ),
    [core],
  )

  useEffect(() => () => struct.dispose(), [struct])

  const revealRef = useRef(0)
  const wireRef = useRef<import('three').Mesh>(null)
  const pointsRef = useRef<import('three').Points>(null)

  useFrame((_, dt) => {
    const u = struct.uniforms

    // Mismo crecimiento que la rosa, exactamente igual, y el mismo frente:
    // (grow · (1 + uWidth)) para que el último anillo llegue a estar
    // completo. Si no fuera idéntico, la transición entre los dos modos se
    // notaría como un salto en vez de como un desvanecimiento.
    const grow = roseGrow(schedule)
    u.uProgress.value = grow * (1 + u.uWidth.value)
    u.uGlowStrength.value = frontGlow(schedule, 0.35)

    // Cuánta estructura se ve. Durante el florecimiento empieza en 1 y se
    // desvanece a partir del 55 %, cediéndole sitio a la superficie; después,
    // sólo si el usuario lo pide. Se amortigua para que el cambio de modo no
    // aparezca ni desaparezca de golpe.
    const target = mathReveal(schedule, mode)
    revealRef.current = MathUtils.damp(revealRef.current, target, 3.2, Math.min(dt, 0.1))
    const reveal = revealRef.current

    u.uOpacity.value = reveal
    const visible = reveal > 0.01
    if (wireRef.current) wireRef.current.visible = visible
    if (pointsRef.current) pointsRef.current.visible = visible
    struct.wireframe.opacity = reveal * 0.9
  })

  return (
    <group>
      <mesh
        ref={wireRef}
        geometry={rose.geometry}
        material={struct.wireframe}
        renderOrder={3}
        visible={false}
        frustumCulled={false}
      />
      <points
        ref={pointsRef}
        geometry={rose.geometry}
        material={struct.points}
        renderOrder={4}
        visible={false}
        frustumCulled={false}
      />
    </group>
  )
}
</file>

<file path="src/components/Scene/Background.tsx">
import { useEffect, useMemo } from 'react'
import { BackSide, BufferAttribute, Color, MeshBasicMaterial, SphereGeometry } from 'three'

import { PALETTE } from '../../config'

const SKY_RADIUS = 40
const SEGMENTS = { width: 48, height: 32 }

/**
 * Fondo degradado: una esfera grande vista por dentro, con el color
 * calculado por vértice y MeshBasicMaterial.
 *
 * Elegido a propósito en lugar de un shaderMaterial propio. Un material propio
 * tiene que resolver él mismo el espacio de color — es exactamente el sitio
 * donde un fondo sale demasiado oscuro o demasiado magenta y no se nota hasta
 * que se ve en el navegador. MeshBasicMaterial ya sabe dónde vive el color.
 *
 * El degradado son tres paradas (#070304 → #100408 → #16060B) y hay un halo
 * radial extremadamente suave apuntando hacia donde está la rosa. Nunca hay
 * negro puro. El vignette va aparte, en CSS, porque no cuesta pasada.
 */
export function Background({ haloDir }: { haloDir: [number, number, number] }) {
  const { geometry, material } = useMemo(() => {
    const stops: [number, Color][] = [
      [-1, new Color(PALETTE.bgBottom)],
      [0, new Color(PALETTE.bgMid)],
      [1, new Color(PALETTE.bgTop)],
    ]
    const halo = new Color(PALETTE.halo)
    const hx = haloDir[0], hy = haloDir[1], hz = haloDir[2]
    const hl = Math.hypot(hx, hy, hz) || 1
    const ax = hx / hl, ay = hy / hl, az = hz / hl

    const geo = new SphereGeometry(SKY_RADIUS, SEGMENTS.width, SEGMENTS.height)
    const pos = geo.getAttribute('position') as BufferAttribute
    const colors = new Float32Array(pos.count * 3)
    const tmp = new Color()

    for (let i = 0; i < pos.count; i++) {
      const x = pos.getX(i), y = pos.getY(i), z = pos.getZ(i)
      const len = Math.hypot(x, y, z) || 1
      const h = y / len
      // Tres paradas con smoothstep en cada tramo: los medianos quedan bien
      // repartidos en vez de tener un escalón en el ecuador.
      const t = h < 0 ? h + 1 : h
      if (h >= 0) {
        const k = smoothstep(0.45, 1, h)
        tmp.copy(stops[1][1]).lerp(stops[2][1], k)
      } else {
        const k = smoothstep(0, 0.55, t)
        tmp.copy(stops[0][1]).lerp(stops[1][1], k)
      }
      // Halo: cuadrado del producto punto con la dirección de la rosa, con la
      // potencia alta para que no alcance media esfera.
      const d = (x / len) * ax + (y / len) * ay + (z / len) * az
      if (d > 0) tmp.lerp(halo, Math.pow(d, 8) * 0.18)

      colors[i * 3] = tmp.r
      colors[i * 3 + 1] = tmp.g
      colors[i * 3 + 2] = tmp.b
    }
    geo.setAttribute('color', new BufferAttribute(colors, 3))

    return {
      geometry: geo,
      material: new MeshBasicMaterial({
        vertexColors: true,
        side: BackSide,
        // Se descarta a mano: la esfera envuelve la escena entera y nunca
        // debería cachearse ni cortarse.
        depthWrite: false,
        toneMapped: true,
      }),
    }
  }, [haloDir])

  useMemo(() => void material, [material])

  // La esfera sólo se crea si cambia el halo, que es nunca: la limpieza
  // existe por si algún día se deja de montar el lienzo.
  useEffect(
    () => () => {
      geometry.dispose()
      material.dispose()
    },
    [geometry, material],
  )

  return <mesh geometry={geometry} material={material} renderOrder={-1} frustumCulled={false} />
}

function smoothstep(a: number, b: number, x: number): number {
  const t = Math.min(1, Math.max(0, (x - a) / (b - a)))
  return t * t * (3 - 2 * t)
}
</file>

<file path="src/components/Scene/CameraRig.tsx">
import { useEffect, useRef } from 'react'
import { useFrame, useThree } from '@react-three/fiber'
import { MathUtils, PerspectiveCamera, Vector3 } from 'three'

import { CAMERA } from '../../config'
import { frameRose, type Framing } from '../../math/geometry'
import type { RoseBounds } from '../../math/rose'
import { pushInAmount, type Phase, type Schedule } from '../../state'

const UP = new Vector3(0, 1, 0)
const tmp = new Vector3()

/** Estructural: evita depender del export `Controls`, que cambia de versión. */
interface OrbitControlsLike {
  target: Vector3
  minDistance: number
  maxDistance: number
  update(): void
  addEventListener(type: string, listener: () => void): void
  removeEventListener(type: string, listener: () => void): void
}

export interface CameraRigProps {
  bounds: RoseBounds
  /** Cambia sólo cinco veces en toda la experiencia: no hace falta leerla en el frame. */
  phase: Phase
  schedule: Schedule
  reduced: boolean
  /** Se dispara la primera vez que el usuario toca la escena. */
  onFirstInteraction: () => void
}

/**
 * Encuadre, rotación automática y acercamiento final.
 *
 * ─────────────────────────────────────────────────────────────────────────
 *  POR QUÉ NO SE USA controls.autoRotate
 * ─────────────────────────────────────────────────────────────────────────
 * Leído en el código fuente de three y de drei: OrbitControls.update() sin
 * argumento aplica un ángulo FIJO por frame, de modo que autoRotate es
 * dependiente del framerate — a 120 fps gira el doble que a 60 y la vuelta a
 * los 78 s no existiría. Peor: _rotateLeft escribe en _sphericalDelta, que es
 * el MISMO buffer de inercia que alimenta el arrastre. Al soltar la
 * inercia sigue corriendo, y reanudar el autoRotate encima produce un
 * visible salto.
 *
 * Aquí se rota la cámara a mano y la velocidad pasa por MathUtils.damp, que
 * es continua: arrancar y parar son C0 por construcción, es decir, por
 * diseño, no por suerte.
 * ─────────────────────────────────────────────────────────────────────────
 */
export function CameraRig({
  bounds,
  phase,
  schedule,
  reduced,
  onFirstInteraction,
}: CameraRigProps) {
  const camera = useThree((s) => s.camera) as PerspectiveCamera
  const size = useThree((s) => s.size)
  const controls = useThree((s) => s.controls) as unknown as OrbitControlsLike | null

  const framing = useRef<Framing | null>(null)
  // El objetivo como Vector3: distanceTo/copy/sub no aceptan un trío suelto,
  // y tenlo aparte evita asignar un Vector3 nuevo en cada frame.
  const targetV = useRef(new Vector3())
  const omega = useRef(0)
  const lastInteraction = useRef(-1e9)
  const pushBase = useRef(0)
  const touched = useRef(false)

  // ── Encuadre, a partir exclusivamente del bounding box ───────────────────
  // No hay una sola coordenada de cámara escrita a mano: si mañana cambia la
  // ecuación, esto se recuadra solo.
  useEffect(() => {
    const aspect = Math.max(size.width / Math.max(size.height, 1), 1e-3)
    const f = frameRose(bounds, CAMERA.fov, aspect, CAMERA.headroom)
    framing.current = f

    camera.fov = CAMERA.fov
    camera.near = 0.01
    camera.far = Math.max(f.distance * 20, 40)
    camera.updateProjectionMatrix()

    if (!controls) return
    // Composición armónica: en vertical (móvil) y horizontal (escritorio),
    // desplazamos suavemente el objetivo hacia abajo para que la flor viva en la
    // zona superior y NUNCA se superponga con la dedicatoria en la zona inferior.
    const isPortrait = aspect < 1
    const yShift = isPortrait ? -bounds.radius * 0.24 : -bounds.radius * 0.10
    const targetY = f.target[1] + yShift

    controls.target.set(f.target[0], targetY, f.target[2])
    targetV.current.set(f.target[0], targetY, f.target[2])
    controls.minDistance = f.distance * CAMERA.minDistanceScale
    controls.maxDistance = f.distance * CAMERA.maxDistanceScale

    if (!touched.current) {
      camera.position.set(f.position[0], f.position[1] + yShift, f.position[2])
      camera.lookAt(f.target[0], targetY, f.target[2])
    }
    controls.update()

    ;(window as unknown as Record<string, unknown>).__ROSE_CAMERA__ = {
      setAngles: (azDeg: number, elDeg: number) => {
        touched.current = true
        omega.current = 0
        const az = (azDeg * Math.PI) / 180
        const el = (elDeg * Math.PI) / 180
        const d = f.distance
        camera.position.set(
          f.target[0] + d * Math.cos(el) * Math.sin(az),
          targetY + d * Math.sin(el),
          f.target[2] + d * Math.cos(el) * Math.cos(az)
        )
        camera.lookAt(f.target[0], targetY, f.target[2])
        controls.target.set(f.target[0], targetY, f.target[2])
        controls.update()
      },
    }
  }, [bounds, camera, controls, size.width, size.height])

  // ── 'start' y 'end' son eventos de entrada del usuario, no de cambio ────
  // No se escucha 'change': nuestro propio giro dispara 'change' y detendría
  // la rotación en el primer frame.
  useEffect(() => {
    if (!controls) return
    const mark = () => {
      lastInteraction.current = performance.now()
      omega.current = 0
      if (!touched.current) {
        touched.current = true
        onFirstInteraction()
      }
    }
    controls.addEventListener('start', mark)
    controls.addEventListener('end', mark)
    return () => {
      controls.removeEventListener('start', mark)
      controls.removeEventListener('end', mark)
    }
  }, [controls, onFirstInteraction])

  // La rotación espera a que el florecimiento termine para no competir con el
  // acercamiento.
  useEffect(() => {
    if (phase === 'INTERACTIVE') {
      lastInteraction.current = performance.now()
      omega.current = 0
    }
  }, [phase])

  useFrame((_, dt) => {
    if (!controls) return

    // Acercamiento final: se desplaza la cámara a lo largo de su propia
    // dirección, así el ángulo no cambia y sólo se acerca. Con
    // prefers-reduced-motion no se mueve la cámara en absoluto — no basta con
    // poner la duración a 0, eso la ejecutaría igual y de golpe.
    if (phase === 'BLOOMED' && framing.current && !reduced) {
      const d = camera.position.distanceTo(targetV.current)
      if (d > 1e-4) {
        if (pushBase.current === 0) pushBase.current = d
        const goal = pushBase.current * (1 - CAMERA.introPushIn * pushInAmount(schedule))
        tmp.copy(camera.position).sub(targetV.current).setLength(goal).add(targetV.current)
        camera.position.copy(tmp)
        controls.update()
      }
    } else {
      pushBase.current = 0
    }

    const now = performance.now()
    const wantSpin =
      phase === 'INTERACTIVE' &&
      !reduced &&
      now - lastInteraction.current > CAMERA.autoRotateResumeDelayMs
    const targetOmega = wantSpin ? (2 * Math.PI) / CAMERA.secondsPerRevolution : 0

    omega.current = MathUtils.damp(omega.current, targetOmega, CAMERA.autoRotateRamp, dt)

    const step = omega.current * dt
    if (step > 1e-6) {
      camera.position.sub(targetV.current).applyAxisAngle(UP, step).add(targetV.current)
      controls.update()
    }
  })

  return null
}
</file>

<file path="src/components/Scene/DebugPanel.tsx">
import { useMemo } from 'react'
import { AxesHelper, Box3, Box3Helper, Color, Vector3 } from 'three'

import { getRose } from '../../math/geometry'
import type { Tier } from '../../math/rose'

/**
 * Ayudas 3D de depuración. SÓLO objetos de three: dentro del Canvas de R3F no
 * puede haber elementos del DOM.
 *
 * Aprendido a golpes: tener aquí un `<pre>` para volcar los datos hacía que
 * R3F intentara montarlo como objeto de la escena (no existe `THREE.Pre`) y
 * se cayera el Canvas entero. El panel de texto vive fuera, en DebugReadout.
 */
export function DebugHelpers({ tier }: { tier: Tier }) {
  const rose = useMemo(() => getRose(tier), [tier])

  const box = useMemo(() => {
    const b = rose.bounds
    return new Box3Helper(
      new Box3(
        new Vector3(b.min[0], b.min[1], b.min[2]),
        new Vector3(b.max[0], b.max[1], b.max[2]),
      ),
      new Color(0x5cc8ff),
    )
  }, [rose])

  const axes = useMemo(() => {
    const a = new AxesHelper(rose.bounds.radius * 1.4)
    a.position.set(rose.bounds.center[0], rose.bounds.min[1], rose.bounds.center[2])
    return a
  }, [rose])

  return (
    <>
      <primitive object={axes} />
      <primitive object={box} />
    </>
  )
}
</file>

<file path="src/components/Scene/Effects.tsx">
import { Bloom, EffectComposer } from '@react-three/postprocessing'

import { RENDER } from '../../config'

/**
 * Postprocesado: sólo bloom, y sólo el suficiente para que el frente del
 * crecimiento y los highlights del petalo separen un poco del fondo.
 *
 * NO se aplica ToneMapping aquí. El tone mapping vive en el renderer (ACES,
 * exposición 0.92); si también se añade en el composer se aplica dos veces y
 * el carmesí se desatura hasta el rosa, que es exactamente el fallo que
 * quieres evitar cuando trabajas con rojos profundos.
 *
 * Tampoco hay aberración cromática, glitch ni lens flare: se quiere una escena
 * cinematográfica, no un demostración de GPU. El vignette va en CSS porque
 * no cuesta pasada de render.
 */
export function Effects({ enabled }: { enabled: boolean }) {
  if (!enabled) return null
  return (
    <EffectComposer multisampling={0}>
      <Bloom
        mipmapBlur
        intensity={RENDER.bloomIntensity}
        luminanceThreshold={RENDER.bloomThreshold}
        luminanceSmoothing={RENDER.bloomSmoothing}
        radius={RENDER.bloomRadius}
      />
    </EffectComposer>
  )
}
</file>

<file path="src/components/Scene/Lighting.tsx">
import { PALETTE } from '../../config'

interface LightingProps {
  /** Sombras apagadas en el tier low: en móvil es el coste más alto de la escena. */
  shadows: boolean
  mapSize: number
}

/**
 * Iluminación cinematográfica, no demo de GPU.
 *
 *  · un ambiente casi apagado, para que haya negros de verdad;
 *  · una key cálida desde arriba/lateral, única fuente de sombra;
 *  · un fill rojizo muy suave que no sube los negros;
 *  · un rim trasero que separa la silueta del fondo oscuro.
 *
 * Las sombras están aquí por un motivo concreto: son lo que hace que se
 * distingan las capas de pétalos. Sin ellas la rosa se aplana en un rojo
 * homogéneo.
 */
export function Lighting({ shadows, mapSize }: LightingProps) {
  return (
    <>
      <ambientLight intensity={0.3} color={PALETTE.lightAmbient} />

      {/* Key: la única que proyecta sombra. */}
      <directionalLight
        position={[2.4, 4.2, 1.6]}
        intensity={2.9}
        color={PALETTE.lightKey}
        castShadow={shadows}
        shadow-mapSize-width={mapSize}
        shadow-mapSize-height={mapSize}
        shadow-bias={-0.0012}
        shadow-normalBias={0.02}
        // Caja ajustada al radio real de la rosa: si es demasiado grande la
        // resolución se desperdicia y el sombreado sale de bandas.
        shadow-camera-left={-1.6}
        shadow-camera-right={1.6}
        shadow-camera-top={1.6}
        shadow-camera-bottom={-1.6}
        shadow-camera-near={0.1}
        shadow-camera-far={12}
      />

      {/* Fill rojizo, sin proyectar. */}
      <pointLight position={[-3, 1.2, -1]} intensity={2.6} color={PALETTE.lightFill} distance={14} decay={2} />

      {/* Rim trasero: separa la silueta del fondo. */}
      <directionalLight position={[-1.5, 1.8, -3.2]} intensity={1.2} color={PALETTE.rim} />
    </>
  )
}
</file>

<file path="src/components/UI/CornerButtons.tsx">
import { useRef, useState } from 'react'
import { motion } from 'framer-motion'

import { AUDIO, COPY } from '../../config'

/**
 * El botón π.
 *
 * Es la única puerta de entrada a la matemática, y está deliberadamente
 * escrito en una esquina semitransparente: no es un call-to-action, es algo
 * que se encuentra. La experiencia tiene que entenderse sin abrirlo.
 */
export function MathButton({ visible, onClick }: { visible: boolean; onClick: () => void }) {
  return (
    <motion.button
      type="button"
      className="corner-btn corner-btn--math"
      aria-label={COPY.mathTitle}
      onClick={onClick}
      initial={{ opacity: 0 }}
      animate={{ opacity: visible ? 1 : 0 }}
      transition={{ duration: 1, ease: 'easeInOut' }}
      // Con opacity 0 sigue siendo focalizable con Tab, lo que daría un foco
      // invisible; se desactiva de verdad cuando no se ve.
      disabled={!visible}
      tabIndex={visible ? 0 : -1}
    >
      π
    </motion.button>
  )
}

/**
 * El botón de música.
 *
 * Nunca se reproduce nada automáticamente: los navegadores móviles lo
 * bloquean y además sería invasivo. Sin pista configurada en
 * `AUDIO.trackUrl` aparece deshabilitado y la aplicación funciona igual, sin
 * haber cargado un solo byte de audio.
 */
export function AudioToggle({ visible }: { visible: boolean }) {
  const [on, setOn] = useState(false)
  const [failed, setFailed] = useState(false)
  const ref = useRef<HTMLAudioElement | null>(null)

  const hasTrack = AUDIO.trackUrl !== null
  if (!hasTrack || failed) return null

  const toggle = () => {
    if (AUDIO.trackUrl === null) return
    if (!ref.current) {
      const a = new Audio(AUDIO.trackUrl)
      a.loop = true
      a.volume = 0.35
      ref.current = a
    }
    const a = ref.current
    if (on) {
      a.pause()
      setOn(false)
      return
    }
    // Puede rechazarse aunque lo haya pedido el usuario (p. ej. gesto no
    // válido en iOS). Si falla, el botón se oculta y punto.
    a.play()
      .then(() => setOn(true))
      .catch(() => setFailed(true))
  }

  return (
    <motion.button
      type="button"
      className={`corner-btn corner-btn--audio${on ? ' is-on' : ''}`}
      aria-label={COPY.audio}
      aria-pressed={on}
      onClick={toggle}
      initial={{ opacity: 0 }}
      animate={{ opacity: visible ? 1 : 0 }}
      transition={{ duration: 1, ease: 'easeInOut' }}
      disabled={!visible}
      tabIndex={visible ? 0 : -1}
    >
      ♪
    </motion.button>
  )
}
</file>

<file path="src/components/UI/DebugReadout.tsx">
import { useEffect, useState } from 'react'

import type { Quality } from '../../hooks/useQuality'
import { getRose } from '../../math/geometry'
import type { RoseParams } from '../../math/rose'

interface Snapshot {
  phase?: string
  phaseMs?: number
  grow?: number
  mathReveal?: number
  mode?: string
  reduced?: boolean
  tier?: string
  dpr?: number
  shadows?: boolean
  bloom?: boolean
  fps?: number
}

/**
 * El panel de texto de depuración.
 *
 * Vive FUERA del Canvas, como DOM normal. Dentro sólo pueden ir objetos de
 * three, y un `<pre>` ahí dentro tira la escena entera (ver DebugHelpers).
 *
 * Lee `window.__ROSE_DEBUG__`, que App escribe una vez por frame en modo
 * debug, y lo refresca a 4 Hz: a 60 Hz el texto sería ilegible y el coste de
 * re-render no tendría ningún sentido. El FPS lo mide ese mismo rAF de App,
 * así que aquí no hay ningún bucle propio.
 */
export function DebugReadout({ quality }: { quality: Quality }) {
  const [snap, setSnap] = useState<Snapshot>({})

  useEffect(() => {
    const read = () => {
      const d = (window as unknown as { __ROSE_DEBUG__?: Snapshot }).__ROSE_DEBUG__
      if (d) setSnap({ ...d })
    }
    read()
    const id = window.setInterval(read, 250)
    return () => window.clearInterval(id)
  }, [])

  const rose = getRose(quality.tier)
  const p = rose.params as RoseParams
  const phiRim = (Math.PI / 2) * Math.exp(-p.thetaMap / (8 * Math.PI))
  const f3 = (v: number) => v.toFixed(3)

  const lines = [
    `fase       ${snap.phase ?? '?'}   ${snap.grow !== undefined ? `grow ${f3(snap.grow)}` : ''}`,
    `fase ms    ${snap.phaseMs ?? '?'}`,
    `estructura ${snap.mathReveal !== undefined ? f3(snap.mathReveal) : '?'}   modo ${snap.mode ?? '?'}`,
    `reduced    ${snap.reduced ?? '?'}`,
    `fps        ${snap.fps ?? '?'}`,
    `tier       ${snap.tier ?? quality.tier}`,
    `dpr        ${snap.dpr ?? quality.dpr}`,
    `sombras    ${snap.shadows ? `sí · ${quality.mapSize}²` : 'no'}`,
    `bloom      ${snap.bloom ? 'sí' : 'no'}`,
    `vértices   ${rose.vertexCount}`,
    `triángulos ${rose.triangleCount}`,
    `pétalos    ${p.petals}  (qSeg ${p.qSeg}, arcSeg ${p.arcSeg})`,
    `radio      ${f3(rose.bounds.radius)}   aspecto ${f3(rose.bounds.aspect)}`,
    `φ(borde)   ${((phiRim * 180) / Math.PI).toFixed(1)}°`,
  ]

  return <pre className="debug-panel">{lines.join('\n')}</pre>
}
</file>

<file path="src/components/UI/Dedication.tsx">
import { AnimatePresence, motion } from 'framer-motion'

import { COPY } from '../../config'

/**
 * El mensaje final.
 *
 * Tres bloques con jerarquías muy distintas: el mensaje es lo único que
 * importa, la dedicatoria está debajo en un tamaño pequeño y la firma es casi
 * un detalle. Esa diferencia de escala es lo que hace que se lea como una
 * nota y no como un titular.
 */
export function Dedication({ visible, durationMs }: { visible: boolean; durationMs: number }) {
  const duration = Math.max(durationMs / 1000, 0.05)
  return (
    <AnimatePresence>
      {visible ? (
        <motion.div
          className="dedication"
          // x: '-50%' va AQUÍ y no en el CSS: Framer Motion escribe la
          // propiedad `transform` en línea, y esa línea pisa el
          // `translateX(-50%)` de la hoja de estilos. Con el desplazamiento
          // dentro de la animación el bloque queda centrado de verdad; con
          // el CSS solo, se quedaba desplazado media caja a la derecha.
          initial={{ opacity: 0, x: '-50%', y: 10 }}
          animate={{ opacity: 1, x: '-50%', y: 0 }}
          exit={{ opacity: 0, x: '-50%' }}
          transition={{ duration, ease: [0.22, 0.61, 0.36, 1] }}
          aria-live="polite"
        >
          <p className="dedication__message">{COPY.message}</p>
          <p className="dedication__to">{COPY.dedication}</p>
          <p className="dedication__from">{COPY.signoff}</p>
        </motion.div>
      ) : null}
    </AnimatePresence>
  )
}
</file>

