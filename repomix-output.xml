  font-style: italic;
  font-size: clamp(0.62rem, 2.2vw, 0.72rem);
  letter-spacing: 0.05em;
  color: var(--ink-faint);
}`)

if (css.includes(oldDedCss)) {
  css = css.replace(oldDedCss, newDedCss)
  css = css.replace('bottom: calc(5% + var(--safe-b));', 'bottom: calc(1.8% + var(--safe-b));')
