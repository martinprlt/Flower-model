{
  "name": "una-rosa-que-no-puede-marchitarse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "validate": "npm run validate:rose && npm run validate:experience",
    "validate:rose": "node --experimental-strip-types scripts/validate-rose.mjs",
    "validate:experience": "node --experimental-strip-types scripts/validate-experience.mjs",
    "render": "node --experimental-strip-types scripts/render-rose.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "framer-motion": "14.0.0",
    "katex": "0.19.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
